{
    "name": "fusani/raider-io",
    "description": "Raider io api sdk",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Fusani\\RaiderIO\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fusani\\RaiderIO\\": "tests/unit/",
            "Fusani\\RaiderIO\\Live\\": "tests/live/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "test:live": "phpunit --testsuite Live",
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
