{
    "name": "fusani/raider-io",
    "description": "PHP SDK for the Raider.IO API: World of Warcraft Mythic+ scores and runs for characters",
    "type": "library",
    "keywords": [
        "raider.io",
        "raiderio",
        "world of warcraft",
        "warcraft",
        "wow",
        "mythic plus",
        "api",
        "sdk"
    ],
    "homepage": "https://github.com/lokisapocalypse/raider-io-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Brian Lamb",
            "email": "brian.lamb@fusaniapplications.com"
        }
    ],
    "support": {
        "issues": "https://github.com/lokisapocalypse/raider-io-sdk/issues",
        "source": "https://github.com/lokisapocalypse/raider-io-sdk"
    },
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Fusani\\RaiderIO\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fusani\\RaiderIO\\": "tests/unit/",
            "Fusani\\RaiderIO\\Live\\": "tests/live/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "test:live": "phpunit --testsuite Live",
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
