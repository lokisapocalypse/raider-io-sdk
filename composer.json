{
    "name": "fusani/raider-io",
    "description": "Raider io api sdk",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Fusani\\RaiderIO\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fusani\\RaiderIO\\": "tests/unit/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true
    }
}
